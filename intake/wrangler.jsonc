{
  "name": "wiser-crm-intake",
  "main": "worker.ts",
  "compatibility_date": "2025-04-01",
  "d1_databases": [
    {
      "binding": "INTAKE_DB",
      "database_name": "wiser-crm-intake-db",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "INTAKE_ORIGIN": "https://example.test",
    "INTAKE_RETURN_URL": "https://example.test/thanks"
  },
  "send_metrics": false
}
