{
  "name": "wiser-crm",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wiser-crm-db",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "AGENT_CLIENT_ID": "",
    "WISER_INSTANCE": "",
    "WISER_READ_ONLY": ""
  }
}
