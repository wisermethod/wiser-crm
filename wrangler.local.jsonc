{
  "name": "wiser-crm-local",
  "main": "worker/dev/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wiser-crm-db",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "WISER_LOCAL_DEV": "1"
  }
}
